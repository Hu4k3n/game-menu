# Endpoint the AskBar posts questions to. Defaults to /api/ask when unset.
# This must point at your own backend, which holds the LLM provider key and calls
# the model server-side.
#
# Contract:
#   POST  { "question": "..." }  ->  200  { "answer": "..." }
#
# Every REACT_APP_* value is inlined into the public JS bundle at build time, so
# never put a provider API key, token, or secret in this file.
REACT_APP_ASK_API_URL=http://localhost:8787/api/ask
